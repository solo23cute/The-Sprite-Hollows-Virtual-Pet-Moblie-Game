# Copy this file to .env for local work: `cp .env.example .env`.
# .env is gitignored, so keys stay out of the repository and out of the game.
# Deployed workers do not read this file: set the same names in
# Sites -> Sprite Hollow -> Secrets, which injects them as env vars.

# The app's client id. Public by design -- it appears in the PayPal sign-in URL.
PAYPAL_CLIENT_ID=your-sandbox-client-id

# Server-side only. This one must never reach the browser, a log, or the repo.
PAYPAL_CLIENT_SECRET=your-sandbox-client-secret

# sandbox while testing against sandbox.paypal.com, live for real money.
# Left unset the server assumes live.
PAYPAL_MODE=sandbox

# Optional: pin the return URL when it differs from the origin players reach.
# PAYPAL_REDIRECT_URL=https://example.com/api/paypal/callback
