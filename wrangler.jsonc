{
  "name": "sprite-hollow-coin-pets",
  "private": true,
  "compatibility_date": "2025-09-01",
  "main": "server/worker.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "exclude": ["server/*", ".coinpets/*", "node_modules/*", "*.apk"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "coin-pets",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID"
    }
  ],
  "observability": { "enabled": true }
}
