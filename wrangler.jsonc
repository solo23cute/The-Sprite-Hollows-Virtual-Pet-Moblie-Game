// The live site runs on Freebuff Sites: D1 binding DB, assets from the game
// bundle, deployed after `bash tools/deploy-bundle.sh`. This file remains for
// `wrangler dev` and self-hosting; fill in a real database_id to use it.
{
  "name": "sprite-hollow-coin-pets",
  "private": true,
  "compatibility_date": "2025-09-01",
  "main": "server/worker.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "exclude": ["server/*", ".coinpets/*", "node_modules/*", "*.apk"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "coin-pets",
      "database_id": "not-used-by-the-live-site"
    }
  ],
  "observability": { "enabled": true }
}
